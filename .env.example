VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

POSTGRES_DB=rc_trainer
POSTGRES_USER=rc_trainer
POSTGRES_PASSWORD=change_me
DATABASE_URL=jdbc:postgresql://localhost:5432/rc_trainer
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_32_byte_or_longer_random_secret_value
GEMINI_API_KEY=

# For Supabase Postgres, replace DATABASE_URL/POSTGRES_* with the Supabase
# connection string and credentials from Project Settings > Database.
